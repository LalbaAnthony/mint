{
  "name": "@mint/front",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit && tsc -p service-worker/tsconfig.json",
    "pwa:assets": "pwa-assets-generator -c pwa-assets.splash.config.ts && pwa-assets-generator -c pwa-assets.badge.config.ts && pwa-assets-generator -c pwa-assets.icons.config.ts"
  },
  "dependencies": {
    "@mint/shared": "^0.0.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@vite-pwa/nuxt": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "echarts": "^6.1.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@nuxt/test-utils": "^4.4.0",
    "@types/sortablejs": "^1.15.9",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/workbox-swkit": "^8.0.15",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
