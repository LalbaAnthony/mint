FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY api/package.json api/
COPY front/package.json front/
COPY shared/package.json shared/
RUN npm ci --workspace @mint/front --ignore-scripts

COPY front/ front/
RUN npm run generate --workspace @mint/front
RUN node front/scripts/write-csp.ts --public front/.output/public --output content-security-policy.conf

FROM nginx:alpine

ENV NGINX_ENTRYPOINT_QUIET_LOGS=1

RUN rm -f /etc/nginx/conf.d/default.conf

COPY front/nginx/nginx.conf /etc/nginx/nginx.conf
COPY front/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/content-security-policy.conf /etc/nginx/snippets/content-security-policy.conf
COPY --from=build /app/front/.output/public /usr/share/nginx/html

USER nginx
RUN nginx -t -q
EXPOSE 8080
