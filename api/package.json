{
  "name": "@mint/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source --clear-screen=false server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "tsx --conditions=source worker.ts",
    "worker:dev": "tsx watch --conditions=source --clear-screen=false worker.ts",
    "migrate": "tsx --conditions=source db/migrate.ts",
    "admin": "tsx --conditions=source cli/admin.ts",
    "seed": "tsx --conditions=source scripts/seed.ts",
    "openapi": "tsx --conditions=source scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@mint/shared": "^0.0.0",
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  }
}
